# App
NODE_ENV=development
APP_ENV=development
PORT=7000

# MongoDB
MONGO_URI=mongodb://localhost:27017/partshub-australia

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1d

# 32-byte hex key, used to encrypt stored credentials — generate: openssl rand -hex 32
ENCRYPTION_KEY=

# OTP / Password Reset
OTP_EXPIRY_MINUTES=2
PASSWORD_RESET_EXPIRY_MINUTES=15

# Redis (Bull queues)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Full connection URL — takes priority over REDIS_HOST/REDIS_PORT above when
# set (e.g. a managed Redis provider's rediss:// URL). Leave blank locally.
REDIS_URL=

# SMTP — platform mailbox, used for system email + alerts
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
ALERTS_TO=

# SMTP throttling
SMTP_MAX_CONNECTIONS=1
SMTP_RATE_LIMIT=1
SMTP_RATE_DELTA_MS=1000

# Email branding
EMAIL_FROM_NAME=Auto Parts Pro
EMAIL_FROM=no-reply@partshub.com.au
SUPPORT_EMAIL=support@partshub.com.au
APP_NAME=Auto Parts Pro

# Frontend URLs
CLIENT_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
STOREFRONT_URL=http://localhost:5174

# Apex domain payment links are built under — "payment.<domain>" for tenants
# on the DEFAULT payment domain mode, "<tenant-slug>.<domain>" (hyphens
# stripped) for VENDOR_SLUG mode — see stripe.payment.service.js#buildPaymentBaseUrl
# and listing.resolver.js#resolveProductUrl (same host, reused as Google
# Shopping's storefront-URL fallback when a tenant has no verified domain).
# Both hosts need DNS + TLS. Leave unset locally — every payment link then
# falls back to CLIENT_URL, and resolveProductUrl throws instead of guessing
# a URL if a tenant also has no verified Domain.
PAYMENT_LINK_DOMAIN=

# Logging
LOG_LEVEL=info

# File uploads
# UPLOADS_DIR defaults to <repo>/uploads if left blank — only set it to
# point uploads somewhere else (e.g. a mounted volume in production).
UPLOADS_DIR=
UPLOADS_URL=http://localhost:7000/uploads

# eBay integration — leave blank to disable eBay sync.
# IMPORTANT: EBAY_CLIENT_ID/EBAY_CLIENT_SECRET must be your app's PRODUCTION
# keyset (App ID + Cert ID from the eBay Developer Portal), even if every
# tenant you're testing with is sandbox-connected. Taxonomy/catalog calls
# (category tree, category aspects, condition-adjacent lookups) always use
# eBay's production endpoints — its sandbox taxonomy tree doesn't work — so
# Sandbox app keys here fail with "invalid_client" on anything that touches
# categories, even though everything else (listing publish/sync) can run
# fully sandboxed. See ebay.api.service.js#getCatalogToken.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_TAXONOMY_BASE_URL=
EBAY_REDIRECT_URI=
# Global API base URL override (e.g. to route through a proxy) — leave blank
# so each tenant's own `sandbox` flag on their eBay connection picks the
# right base URL itself (see ebay.api.service.js).
EBAY_API_BASE_URL=
# eBay's own Bull queue has never had a rate limiter (unrestricted
# throughput) — leave both blank to keep that. Only set EBAY_QUEUE_RATE_MAX
# (requests) + EBAY_QUEUE_RATE_DURATION_MS (window) together if you actually
# want to newly throttle it.
EBAY_QUEUE_RATE_MAX=
EBAY_QUEUE_RATE_DURATION_MS=

# Google Shopping (Merchant API) — leave blank to disable. GOOGLE_CLIENT_ID/
# GOOGLE_CLIENT_SECRET are your app's OAuth 2.0 client credentials from the
# Google Cloud Console (Content API for Shopping / Merchant API scope
# enabled); GOOGLE_REDIRECT_URI must exactly match a redirect URI registered
# against that client, pointed at /api/v1/google/oauth/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Channel sync (eBay + Google Shopping, and any future channel — see
# services/marketplace/ and config/index.js#channels) — leave all of these
# blank/unset to keep their defaults.
# How long a ChannelSyncLog row is kept before it's pruned.
CHANNEL_SYNC_LOG_TTL_DAYS=30
# Log a ChannelSyncLog row for every SUCCESSFUL sync too, not just failures
# — a full-catalogue sync can be thousands of listings, so this floods the
# collection for little operational benefit; leave false unless you're
# actively debugging.
CHANNEL_LOG_SUCCESSES=false
# Consecutive transport/auth failures before a tenant's channel connection
# is paused (circuit breaker) — see services/marketplace/circuitBreaker.js.
CHANNEL_CIRCUIT_BREAKER_THRESHOLD=10
# How long a rapid-fire run of sync_listing calls for the SAME listing (e.g.
# several quick stock corrections) gets debounced into one job.
CHANNEL_SYNC_DEBOUNCE_MS=5000
# How many listings sync.service.js#syncBatch reads off its Mongo cursor per
# chunk before dispatching a platform's batch publish call.
CHANNEL_BATCH_CHUNK_SIZE=500

# Channel refresh sweep — periodically re-pushes any listing on a channel
# that expires stale listings (Google Merchant Center: 30 days), so a
# product with stable stock (no stock change to trigger a normal sync)
# doesn't silently drop off after 30 days. Only applies to a platform whose
# adapter opts in (Google today; eBay never expires listings).
# Days since last successful sync before a listing counts as stale — keep
# this under the channel's real expiry window (Google: 30) to leave
# headroom for a missed run.
CHANNEL_REFRESH_INTERVAL_DAYS=25
# How often the sweep actually runs, in hours.
CHANNEL_REFRESH_SWEEP_INTERVAL_HOURS=24
# Kill switch — set to false to disable the sweep without a deploy.
CHANNEL_REFRESH_SWEEP_ENABLED=true

# Stripe
STRIPE_CURRENCY=aud
# Local-dev-only fallback signing secret for `stripe listen` (which mints a
# fresh whsec_ every session that can never match a tenant's own real stored
# webhook secret — see payment.controller.js#handleWebhook). Tried ONLY
# after the tenant's own secret fails to verify, and ONLY outside
# production. Paste whatever `stripe listen` prints each session. Never set
# this in production.
STRIPE_DEV_WEBHOOK_SECRET=

# Typesense (product search)
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=xyz
TYPESENSE_TIMEOUT_SECONDS=5
