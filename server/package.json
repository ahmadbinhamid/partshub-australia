{
  "name": "server",
  "version": "1.0.0",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --test --test-concurrency=1 'src/**/*.test.js'",
    "worker:channels": "node --max-old-space-size=256 src/workers/channel.worker.js",
    "worker:ebay": "node --max-old-space-size=256 src/workers/ebay.worker.js",
    "worker:stripe": "node --max-old-space-size=256 src/workers/stripe.worker.js",
    "worker:platform": "node --max-old-space-size=256 src/workers/platform.worker.js",
    "seed:superadmin": "node scripts/seedSuperAdmin.js",
    "reindex:products": "node scripts/reindexProducts.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "bull": "^4.16.5",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.1",
    "express-winston": "^4.2.0",
    "handlebars": "^4.7.8",
    "helmet": "^8.1.0",
    "joi": "^18.0.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "mongoose": "^8.17.1",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.5",
    "pdfkit": "^0.19.1",
    "socket.io": "^4.8.1",
    "stripe": "^22.3.1",
    "swagger-ui-express": "^5.0.1",
    "typesense": "^3.0.6",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-plugin-n": "^17.24.0",
    "globals": "^15.15.0",
    "nodemon": "^3.1.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  }
}
