# NOTE: found a FOURTH place disagreeing on Node version, beyond the three
# named in this task (dev machine, server/Dockerfile, ci.yml) — this file
# was also pinned to node:20-alpine, for the frontend's own build stage.
# Same fix, same reasoning: standardise on 22.
FROM node:22-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ARG VITE_API_URL=/api/v1
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx/frontend.nginx.conf /etc/nginx/nginx.conf
EXPOSE 80
